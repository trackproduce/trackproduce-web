FLASK_APP=run.py
FLASK_DEBUG=1
PORT=7015
UPLOAD_FOLDER=uploads

# Database (never commit real values — copy to .env and fill in)
POSTGRES_USER=trackproduce
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trackproduce
DATABASE_URL=postgresql://trackproduce:change-me@db/trackproduce

# Content editor (flask-sitecopy) — /admin/content
# SECRET_KEY signs the editor's admin session. Without it a key is generated per
# process, so with more than one worker the login stops sticking. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# The editor's shared password. Left empty, the panel refuses every password.
SITECOPY_PASSWORD=change-me
# Canonical origin, used for og:url and for the editor's search/share preview cards.
SITE_URL=https://trackproduce.nexttech.com.ar
