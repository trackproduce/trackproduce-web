FLASK_APP=run.py
FLASK_DEBUG=1
PORT=7015
UPLOAD_FOLDER=uploads

# Database (never commit real values — copy to .env and fill in)
POSTGRES_USER=trackproduce
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trackproduce
DATABASE_URL=postgresql://trackproduce:change-me@db/trackproduce

# Content editor (flask-sitecopy) — /admin/content
# Both are left EMPTY on purpose: a placeholder here gets copied into a real .env and
# becomes a publicly known secret. An empty SECRET_KEY makes the app generate a random
# one per process (the panel's login then stops sticking across workers, which is a
# loud enough signal); an empty password makes the panel refuse every password.
# Generate a key with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# The editor's shared password.
SITECOPY_PASSWORD=
# Canonical origin, used for og:url and for the editor's search/share preview cards.
SITE_URL=https://trackproduce.com

# --- Set by Vercel in the deployed environment; unset here on purpose ----------------
# BLOB_READ_WRITE_TOKEN — comes with the Vercel Blob store. Present, the content
#   editor's uploads go to Blob; absent (as locally), they go to UPLOAD_FOLDER.
# DB_AUTO_SCHEMA — whether to create tables at boot. Defaults to on everywhere except
#   Vercel, where scripts/init_db.py does it once instead.
# UMAMI_WEBSITE_ID — analytics. Left out locally so development traffic is not counted.
