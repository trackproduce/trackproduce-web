{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "wsgi.py": {
      "excludeFiles": "{tests/**,plans/**,docs/**,scripts/**,migrations/**,instagram-trackproduce/**,.venv/**,**/__pycache__/**}"
    }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
